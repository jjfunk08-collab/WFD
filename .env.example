# Required: the passcode your family types once per device
FAMILY_PASSCODE=pick-something-memorable

# Required: Upstash Redis (added automatically when you connect Upstash from Vercel's Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Optional: turns on recipe import, suggestions, side ideas, nutrition, and flyer reading
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# SESSION_SECRET=long-random-string   # change it to sign everyone out
# KEY_PREFIX=wfd:
